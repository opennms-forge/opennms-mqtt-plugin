<xml-groups xmlns="http://xmlns.opennms.org/xsd/config/xml-datacollection">

    <xml-group name="xmlfile1" resource-type="node" resource-xpath="/logToFileResponse/equipment.SystemCpuStatsLogRecord">
        <xml-object name="systemCpuUsage" type="GAUGE" xpath="systemCpuUsage"/>
        <xml-object name="timeCaptured" type="GAUGE" xpath="timeCaptured"/>
        <xml-object name="periodicTime" type="GAUGE" xpath="periodicTime"/>
        <xml-object name="monitoredObjectClass" type="STRING" xpath="monitoredObjectClass"/>
        <xml-object name="monitoredObjectPointer" type="STRING" xpath="monitoredObjectPointer"/>
        <xml-object name="displayedName" type="STRING" xpath="displayedName"/>
        <xml-object name="monitoredObjectSiteId" type="STRING" xpath="monitoredObjectSiteId"/>
        <xml-object name="monitoredObjectSiteName" type="STRING" xpath="monitoredObjectSiteName"/>
        <xml-object name="suspect" type="STRING" xpath="suspect"/>
    </xml-group>
</xml-groups>

